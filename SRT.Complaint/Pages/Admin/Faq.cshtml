@page
@model SRT.Complaint.Pages.Admin.FaqModel
@{
    ViewData["Title"] = "จัดการ FAQ";
    var grouped = Model.Items.GroupBy(x => x.Category ?? "ทั่วไป").OrderBy(g => g.Key);
}

<!-- Header -->
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-xl font-bold text-gray-900">จัดการคำถามที่พบบ่อย (FAQ)</h1>
        <p class="text-sm text-gray-500 mt-1">เพิ่ม แก้ไข และจัดลำดับคำถาม-คำตอบที่แสดงในหน้าสาธารณะ</p>
    </div>
    <a asp-page="/Public/Faq" target="_blank"
       class="inline-flex items-center gap-2 text-xs text-srt-navy hover:underline font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        ดูหน้าสาธารณะ
    </a>
</div>

@if (Model.SuccessMessage is not null)
{
    <div class="alert-success mb-4 flex items-center gap-2 text-sm">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        @Model.SuccessMessage
    </div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert-error mb-4 text-sm">@Model.ErrorMessage</div>
}

<!-- Edit FAQ form (inline at top) -->
@if (Model.EditTarget is not null)
{
    var t = Model.EditTarget;
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-5">
        <h2 class="text-sm font-semibold text-blue-900 mb-4">แก้ไข FAQ #@t.Id</h2>
        <form method="post" asp-page-handler="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="editFaqId" value="@t.Id" />
            <div class="grid grid-cols-1 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">
                        คำถาม <span class="text-red-500">*</span>
                    </label>
                    <input name="editQuestion" value="@t.Question" required
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">
                        คำตอบ <span class="text-red-500">*</span>
                    </label>
                    <textarea name="editAnswer" rows="5" required
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy resize-y">@t.Answer</textarea>
                    <p class="text-xs text-gray-400 mt-1">รองรับ HTML — เช่น &lt;ul&gt;&lt;li&gt;, &lt;strong&gt;, &lt;a&gt;</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">หมวดหมู่</label>
                        <input name="editCategory" value="@t.Category"
                               list="category-list"
                               placeholder="เช่น การร้องเรียน, การติดตาม"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy" />
                        <datalist id="category-list">
                            @foreach (var c in Model.ExistingCategories)
                            {
                                <option value="@c" />
                            }
                        </datalist>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">ลำดับ</label>
                        <input name="editSortOrder" type="number" value="@t.SortOrder" min="0"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy" />
                    </div>
                    <div class="flex items-end pb-1">
                        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                            <input type="checkbox" name="editIsActive" value="true"
                                   @(t.IsActive ? "checked" : "")
                                   class="w-4 h-4 rounded border-gray-300 text-srt-navy" />
                            ใช้งานได้
                        </label>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button type="submit"
                            class="bg-srt-navy text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-srt-navy-dark transition">
                        บันทึก
                    </button>
                    <a asp-page="/Admin/Faq"
                       class="bg-gray-100 text-gray-700 px-5 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 transition">
                        ยกเลิก
                    </a>
                </div>
            </div>
        </form>
    </div>
}

<!-- FAQ list grouped by category -->
@if (!Model.Items.Any())
{
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center text-gray-400 mb-5">
        <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm font-medium">ยังไม่มี FAQ</p>
        <p class="text-xs mt-1">ใช้ฟอร์มด้านล่างเพื่อเพิ่มคำถามแรก</p>
    </div>
}
else
{
    <div class="space-y-5 mb-5">
        @foreach (var group in grouped)
        {
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">@group.Key</h2>
                    <div class="flex-1 h-px bg-gray-200"></div>
                    <span class="text-xs text-gray-400">@group.Count() รายการ</span>
                </div>
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                    @foreach (var item in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Id))
                    {
                        <div class="flex items-start gap-3 px-4 py-3.5 border-b border-gray-100 last:border-b-0 @(!item.IsActive ? "opacity-50" : "")">
                            <span class="w-6 text-center text-xs font-mono text-gray-400 shrink-0 mt-0.5">@item.SortOrder</span>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-gray-900 leading-snug">@item.Question</p>
                                <p class="text-xs text-gray-500 mt-0.5 line-clamp-2 leading-relaxed">
                                    @Html.Raw(System.Text.RegularExpressions.Regex.Replace(item.Answer, "<.*?>", ""))
                                </p>
                            </div>
                            @if (item.IsActive)
                            {
                                <span class="flex items-center gap-1 text-xs text-green-700 shrink-0 mt-0.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                    <span class="hidden sm:inline">ใช้งานได้</span>
                                </span>
                            }
                            else
                            {
                                <span class="flex items-center gap-1 text-xs text-gray-400 shrink-0 mt-0.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
                                    <span class="hidden sm:inline">ปิดใช้งาน</span>
                                </span>
                            }
                            <div class="flex items-center gap-3 shrink-0">
                                <a asp-page="/Admin/Faq" asp-route-editId="@item.Id"
                                   class="text-xs text-srt-navy hover:underline font-medium">แก้ไข</a>
                                <form method="post" asp-page-handler="ToggleActive" asp-route-id="@item.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="text-xs @(item.IsActive ? "text-red-600 hover:text-red-800" : "text-green-600 hover:text-green-800") font-medium">
                                        @(item.IsActive ? "ปิดใช้" : "เปิดใช้")
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            onclick="return confirm('ลบคำถาม \"@item.Question.Replace("\"", "\\\"")\" ?')"
                                            class="text-xs text-gray-400 hover:text-red-600 font-medium">ลบ</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Create new FAQ -->
<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
    <h2 class="text-sm font-semibold text-gray-900 mb-4">เพิ่ม FAQ ใหม่</h2>
    <form method="post" asp-page-handler="Create" class="space-y-4">
        @Html.AntiForgeryToken()
        <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">
                คำถาม <span class="text-red-500">*</span>
            </label>
            <input name="newQuestion" required placeholder="เช่น ฉันสามารถยื่นเรื่องร้องเรียนได้อย่างไร?"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy" />
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">
                คำตอบ <span class="text-red-500">*</span>
            </label>
            <textarea name="newAnswer" rows="4" required
                      placeholder="อธิบายคำตอบ... (รองรับ HTML)"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy resize-y"></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">หมวดหมู่</label>
                <input name="newCategory"
                       list="category-list-create"
                       placeholder="เช่น การร้องเรียน"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy" />
                <datalist id="category-list-create">
                    @foreach (var c in Model.ExistingCategories)
                    {
                        <option value="@c" />
                    }
                </datalist>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">ลำดับ</label>
                <input name="newSortOrder" type="number"
                       value="@(Model.Items.Any() ? Model.Items.Max(x => x.SortOrder) + 1 : 1)" min="0"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-srt-navy" />
            </div>
            <div>
                <button type="submit"
                        class="w-full bg-srt-navy text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-srt-navy-dark transition">
                    + เพิ่ม FAQ
                </button>
            </div>
        </div>
    </form>
</div>
