@page
@model SRT.Complaint.Pages.Public.FaqModel
@{
    ViewData["Title"] = "คำถามที่พบบ่อย";
    int itemIdx = 0;

    static string HeaderGradient(string cat) => cat switch
    {
        "การยื่นเรื่องร้องเรียน" => "bg-gradient-to-r from-blue-700 to-blue-600",
        "การติดตามสถานะ"         => "bg-gradient-to-r from-emerald-700 to-emerald-600",
        "การแจ้งเบาะแสทุจริต"   => "bg-gradient-to-r from-amber-700 to-amber-600",
        _                        => "bg-gradient-navy",
    };

    static string HeaderLabel(string cat) => cat switch
    {
        "การยื่นเรื่องร้องเรียน" => "text-blue-200",
        "การติดตามสถานะ"         => "text-emerald-200",
        "การแจ้งเบาะแสทุจริต"   => "text-amber-200",
        _                        => "text-blue-200",
    };

    static string CategoryIcon(string cat) => cat switch
    {
        "การยื่นเรื่องร้องเรียน" =>
            """<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>""",
        "การติดตามสถานะ" =>
            """<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>""",
        "การแจ้งเบาะแสทุจริต" =>
            """<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>""",
        _ =>
            """<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>"""
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
<div class="max-w-2xl mx-auto">

    <!-- Header -->
    <div class="mb-8">
        <nav class="flex items-center gap-2 text-xs text-gray-400 mb-4" aria-label="breadcrumb">
            <a href="/" class="hover:text-srt-navy transition">หน้าแรก</a>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-gray-600 font-medium">คำถามที่พบบ่อย</span>
        </nav>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">คำถามที่พบบ่อย</h1>
        <p class="text-gray-500 mt-2">รวมคำตอบเกี่ยวกับการร้องเรียนและการใช้บริการ รฟท.</p>
    </div>

    @if (!Model.Groups.Any())
    {
        <div class="card p-12 text-center animate-fade-in">
            <div class="w-16 h-16 bg-srt-navy-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-srt-navy/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="font-bold text-gray-900 mb-1">ยังไม่มีคำถามในขณะนี้</p>
            <p class="text-gray-500 text-sm">กรุณาติดต่อเจ้าหน้าที่ที่หมายเลข 1690</p>
        </div>
    }
    else
    {
        <!-- Search bar — same style as Track's search -->
        <div class="flex gap-2 bg-white border border-gray-200 rounded-2xl p-2 shadow-card mb-2">
            <div class="flex-1 relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input id="faq-search"
                       type="text"
                       placeholder="ค้นหาคำถาม เช่น รหัสอ้างอิง, ระยะเวลา..."
                       class="w-full bg-transparent border-0 text-sm text-gray-900 pl-10 pr-3 py-2.5
                              focus:outline-none focus:ring-2 focus:ring-srt-navy focus:ring-inset placeholder:text-gray-400" />
            </div>
            <button type="button" onclick="clearSearch()" id="clear-btn"
                    class="hidden shrink-0 btn-secondary btn-sm">ล้าง</button>
        </div>
        <p id="search-empty" class="hidden text-xs text-gray-400 mb-8 px-1">
            ไม่พบคำถามที่ตรงกับ "<span id="search-term" class="font-semibold text-gray-600"></span>"
        </p>
        <p class="text-xs text-gray-400 mb-8 px-1" id="search-hint">
            @Model.Groups.Sum(g => g.Count()) คำถาม ใน @Model.Groups.Count() หมวด
        </p>

        <!-- FAQ groups -->
        <div id="faq-container" class="space-y-4">
            @foreach (var group in Model.Groups)
            {
                var gradient = HeaderGradient(group.Key);
                var labelColor = HeaderLabel(group.Key);

                <div class="faq-group card overflow-hidden animate-fade-in">

                    <!-- Card header — same pattern as Track's gradient header -->
                    <div class="@gradient px-6 py-4 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <svg class="w-5 h-5 text-white/80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                @Html.Raw(CategoryIcon(group.Key))
                            </svg>
                            <div>
                                <p class="@labelColor text-[11px] font-semibold uppercase tracking-wider leading-none mb-0.5">หมวดหมู่</p>
                                <p class="font-bold text-white text-base leading-tight">@group.Key</p>
                            </div>
                        </div>
                        <span class="bg-white/20 text-white text-xs font-semibold px-2.5 py-1 rounded-full">
                            @group.Count() ข้อ
                        </span>
                    </div>

                    <!-- Accordion items -->
                    <div class="divide-y divide-gray-100">
                        @foreach (var item in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Id))
                        {
                            var idx = itemIdx++;
                            <div class="faq-item">
                                <button type="button"
                                        onclick="toggleFaq(@idx)"
                                        aria-expanded="false"
                                        aria-controls="faq-ans-@idx"
                                        class="faq-question w-full flex items-start gap-4 text-left px-6 py-4
                                               hover:bg-gray-50 transition-colors duration-150 group">
                                    <div class="flex-1 min-w-0 pt-0.5">
                                        <p class="text-sm font-semibold text-gray-900 leading-snug group-hover:text-srt-navy transition-colors">
                                            @item.Question
                                        </p>
                                    </div>
                                    <svg id="faq-icon-@idx"
                                         class="w-4 h-4 text-gray-400 shrink-0 mt-1 transition-transform duration-200"
                                         fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>

                                <div id="faq-ans-@idx" class="faq-answer hidden bg-gray-50 border-t border-gray-100">
                                    <div class="px-6 py-4">
                                        <p class="text-sm text-gray-700 leading-relaxed">@Html.Raw(item.Answer)</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- CTA — same card style as Track -->
    <div class="card p-8 text-center mt-6">
        <div class="w-14 h-14 bg-srt-navy-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-srt-navy/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
        </div>
        <p class="font-bold text-gray-900 mb-1">ยังไม่พบคำตอบที่ต้องการ?</p>
        <p class="text-gray-500 text-sm mb-6">ยื่นเรื่องร้องเรียนหรือติดต่อเจ้าหน้าที่โดยตรงที่หมายเลข
            <a href="tel:1690" class="font-semibold text-srt-navy hover:underline">☎ 1690</a>
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a asp-page="/Public/Submit" class="btn-primary shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                ยื่นเรื่องร้องเรียน
            </a>
            <a asp-page="/Public/Track" class="btn-secondary shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                ติดตามสถานะ
            </a>
        </div>
    </div>

</div>
</div>

@section Scripts {
<script>
    function toggleFaq(idx) {
        var ans  = document.getElementById('faq-ans-' + idx);
        var icon = document.getElementById('faq-icon-' + idx);
        var btn  = icon.closest('button');
        var open = !ans.classList.contains('hidden');
        ans.classList.toggle('hidden', open);
        icon.style.transform = open ? '' : 'rotate(180deg)';
        btn.setAttribute('aria-expanded', String(!open));
    }

    function clearSearch() {
        var inp = document.getElementById('faq-search');
        inp.value = '';
        inp.dispatchEvent(new Event('input'));
        inp.focus();
    }

    var searchInput = document.getElementById('faq-search');
    var searchEmpty = document.getElementById('search-empty');
    var searchHint  = document.getElementById('search-hint');
    var searchTerm  = document.getElementById('search-term');
    var clearBtn    = document.getElementById('clear-btn');

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            var q     = this.value.trim().toLowerCase();
            var items = document.querySelectorAll('.faq-item');
            var found = 0;

            items.forEach(function (item) {
                var show = !q || item.textContent.toLowerCase().includes(q);
                item.style.display = show ? '' : 'none';
                if (show) found++;
                var ans = item.querySelector('.faq-answer');
                if (ans) {
                    if (q && show) ans.classList.remove('hidden');
                    else if (!q)  ans.classList.add('hidden');
                }
            });

            document.querySelectorAll('.faq-group').forEach(function (g) {
                var visible = Array.from(g.querySelectorAll('.faq-item'))
                    .some(function (i) { return i.style.display !== 'none'; });
                g.style.display = visible ? '' : 'none';
            });

            if (searchTerm) searchTerm.textContent = this.value;
            if (searchEmpty) searchEmpty.classList.toggle('hidden', found > 0 || !q);
            if (searchHint)  searchHint.classList.toggle('hidden', !!q);
            if (clearBtn)    clearBtn.classList.toggle('hidden', !q);
        });
    }
</script>
}
